VITE_BOT_USERNAME=lumen_game_bot
# Nombre corto de la Mini App configurado en BotFather (opcional; si está vacío se usa el enlace directo del bot).
VITE_APP_SHORT_NAME=
# ID del bloque de AdsGram (se usará en el hito 5).
VITE_ADSGRAM_BLOCK_ID=
