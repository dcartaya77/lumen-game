# Username del bot de Telegram (sin @). Se usa para construir el enlace compartible.
VITE_BOT_USERNAME=lumen_game_bot
# Nombre corto de la Mini App configurado en BotFather (opcional; si está vacío se usa el enlace directo del bot).
VITE_APP_SHORT_NAME=

# --- Anuncios (todos opcionales; sin IDs el juego funciona sin anuncios) ---
# AdsGram (principal): ID del bloque "Rewarded video" de https://partner.adsgram.ai
VITE_ADSGRAM_BLOCK_ID=
# Monetag (respaldo): ID de la zona principal del SDK y URL del sdk.js que da el panel.
VITE_MONETAG_ZONE_ID=
VITE_MONETAG_SDK_URL=https://libtl.com/sdk.js
# auto (por defecto): usa los proveedores con ID; mock: anuncio simulado; none: sin anuncios.
VITE_ADS_PROVIDER=auto
